{
  "manifest_version": 3,
  "name": "Speacher — AI-диктовка",
  "short_name": "Speacher",
  "version": "0.2.0",
  "description": "Говорите — текст появляется в любом поле любой вкладки. Whisper Large v3 + чистка текста. Со своим ключом Groq.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Speacher — начать диктовку",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "offscreen",
    "commands"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Начать или завершить диктовку"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}