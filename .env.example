# Ключ Groq (https://console.groq.com/keys). Без него приложение запустится,
# но транскрипция вернёт понятную ошибку 503.
GROQ_API_KEY=

# Порт API-сервера (должен совпадать с proxy в vite.config.ts)
API_PORT=8787

# Модели. turbo — дешевле и быстрее, large-v3 — точнее.
ASR_MODEL=whisper-large-v3-turbo
ASR_MODEL_ACCURATE=whisper-large-v3
LLM_MODEL=openai/gpt-oss-20b

# Максимальный размер загружаемого аудио, МБ (лимит Groq free tier — 25)
MAX_UPLOAD_MB=25
